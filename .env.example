# ─── Database ─────────────────────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=crisislink_root
MYSQL_DATABASE=crisislink_db
MYSQL_USER=crisislink_user
MYSQL_PASSWORD=crisislink_pass
MYSQL_PORT=3306
MYSQL_HOST=localhost

# ─── MongoDB ──────────────────────────────────────────────────────────────
# MONGO_USER / MONGO_PASSWORD / MONGO_PORT are only used by docker-compose.
MONGO_USER=admin
MONGO_PASSWORD=crisislink_mongo
MONGO_PORT=27017

# Used by the Flask backend (local Windows install, no Docker).
# Local MongoDB without authentication (default for a fresh Windows install):
MONGO_URI=mongodb://localhost:27017
# With authentication enabled, use placeholders like this and put the real values only in your .env:
# MONGO_URI=mongodb://<username>:<password>@localhost:27017/?authSource=admin
MONGO_DB_NAME=crisislink_nosql
MONGO_UPDATES_COLLECTION=emergency_updates
MONGO_TIMEOUT_MS=3000
# Verify that incident_id exists in MySQL when creating/editing an emergency update
EMERGENCY_UPDATES_VERIFY_INCIDENT=true

# ─── Neo4j ────────────────────────────────────────────────────────────────
NEO4J_USER=neo4j
NEO4J_PASSWORD=crisislink_neo4j
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687

# ─── ChromaDB ─────────────────────────────────────────────────────────────
CHROMA_PORT=8001

# ─── Flask ────────────────────────────────────────────────────────────────
FLASK_ENV=development
SECRET_KEY=change_this_secret_key_in_production
JWT_SECRET_KEY=change_this_jwt_secret_in_production
BACKEND_PORT=5000

# ─── Next.js ──────────────────────────────────────────────────────────────
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:5000
